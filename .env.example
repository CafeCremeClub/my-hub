# Copier ce fichier en .env.local et renseigner les valeurs ci-dessous.
# Ne JAMAIS committer de vraies valeurs ici : ce fichier est un template public.

# URL de base de l'API backend externe MyHub (sans slash final).
# Backend hébergé sur Render : https://my-hub-be.onrender.com/my-hub
# Sert à tous les appels API (connexion, envoi OTP, missions, profil, etc.).
NEXT_PUBLIC_BASE_URL=

# Clé PUBLIQUE Stripe (pk_...). Optionnelle.
# Le paiement est actuellement DÉSACTIVÉ dans le code (StripeContext commenté),
# donc cette variable n'est lue que si le paiement est réactivé.
# Utiliser de préférence une clé pk_test_... en développement.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
